{
  "name": "fantasy-mission-control",
  "version": "0.1.0",
  "description": "Fantasy Mission Control -- the desktop cockpit for the ff-assistant engine",
  "main": "main.js",
  "scripts": {
    "start": "electronmon .",
    "start:plain": "electron .",
    "build:engine": "cd .. && npm run build:engine",
    "dist": "npm run build:engine && electron-builder --dir",
    "dist:installer": "npm run build:engine && electron-builder"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^26.15.3",
    "electronmon": "^2.0.4"
  },
  "build": {
    "appId": "com.ffassistant.missioncontrol",
    "productName": "Fantasy Mission Control",
    "directories": { "output": "../dist-app" },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "extraResources": [
      { "from": "engine/ff.cjs", "to": "engine/ff.cjs" },
      { "from": "engine/schema.sql", "to": "engine/schema.sql" },
      { "from": "engine/node_modules", "to": "engine/deps" },
      { "from": "runtime", "to": "runtime" }
    ],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false }
  }
}
