{
  "name": "ff-assistant",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Copresent fantasy football agent -- draft-day sprint harness (ESPN first).",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ff": "./src/ff.ts"
  },
  "scripts": {
    "ff": "tsx src/ff.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build:engine": "esbuild src/ff.ts --bundle --platform=node --format=cjs --target=node20 --outfile=app/engine/ff.cjs --external:better-sqlite3 --external:playwright-core --external:@anthropic-ai/claude-agent-sdk --external:electron --banner:js=\"const import_meta_url=require('url').pathToFileURL(__filename).href;\" --define:import.meta.url=import_meta_url && node -e \"require('fs').copyFileSync('src/db/schema.sql','app/engine/schema.sql')\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.259",
    "@dagrejs/dagre": "^3.1.1",
    "better-sqlite3": "^13.0.3",
    "playwright-core": "^1.48.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
