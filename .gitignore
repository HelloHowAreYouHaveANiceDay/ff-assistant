node_modules/
dist/
*.log
.env
.env.*
data/*.db
data/*.sqlite
data/draft-log-*.json
data/cheatsheet.md
data/*-dom.json
data/draft-dom-snapshot.json
.DS_Store
diag.mjs
diag*.png
inspect.mjs
data/live-state.json
data/*.db-wal
data/*.db-shm

# bundled node runtime for the packaged build (placed locally, not committed)
app/runtime/

# per-league personal data (real owner identities + draft history) -- never ship; the sim falls back
# to a generic field when absent (src/draft/managers.ts)
data/managers.json
data/owners.json
data/recaps.json
# The human-readable scouting report DERIVED from those three. It names real league members and
# characterises how each of them drafts, so it is exactly as personal as its inputs and belongs in
# the same bucket -- per install, never committed. It lived in docs/ until 2026-09-05 and was purged
# from history when the repo went public. Same pattern as data/cheatsheet.md: a generated markdown
# artifact that stays local.
data/league-managers.md

# derived per-league backtest history (scored under the league's own scoring model) -- rebuild with
# `ff build-history`; committing it would ship one league's scoring to everyone
data/history-points.csv
data/history-weekly.csv
data/rank-outcomes.json

# electron-builder output + compiled engine bundle
dist-app/
app/engine/

# mock-draft harness output (per-run logs + records)
data/mock-runs.jsonl
data/mock-*.log
data/auto-draft.lock
data/history-*.bak.csv
data/trials/
data/managers.*.bak.json
data/pos-sweep.txt

# Runtime bridge endpoint: holds a live auth token for the app's loopback API. Never commit.
data/app-bridge.json

# Per-fold evaluation output: one trained artifact per held-out season, and the per-fold residual
# dump the feature screen reads. Both are rebuilt by `ff evaluate-projection` in about 20 seconds
# and both are league-scored, so they belong with history-*.csv rather than in the repo.
data/fold-artifacts/
data/residuals.tsv

# Backups taken before a rebuild, for the "did any NUMBER change?" comparison. Local by definition.
data/*.prev.csv

# Downloaded nflverse feeds, kept so a feature sweep can be re-run in seconds instead of
# re-fetching ~300MB. Pure cache: every file is reproducible with --refresh, and nothing
# reads it that cannot rebuild it.
data/cache/
